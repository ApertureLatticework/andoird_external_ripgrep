// ignore 0.4.23 —— 树内无，vendored（0.4.24+ 转 edition 2024，钉 0.4.23）
rust_library {
    // 纯依赖件：不出 dylib 安装，避让树内同名断代老模块的 install 位
    dylib: false,
    name: "liboperit_ignore",
    crate_name: "ignore",
    stem: "libignore",
    crate_root: "src/lib.rs",
    cargo_pkg_version: "0.4.23",
    edition: "2021",
    rustlibs: [
        "libcrossbeam_deque",
        "liboperit_globset",
        "liblog_rust",
        "libmemchr",
        "liboperit_regex_automata",
        "libsame_file",
        "libwalkdir",
    ],
    visibility: ["//visibility:public"],
}
