// regex-automata 0.4.14 —— 树内 0.1 断代，vendored
// features 为全叶闭包：Soong 不追踪 cargo feature 蕴含（nfa→nfa-thompson 等），逐叶显式
rust_library_rlib {
    name: "liboperit_regex_automata",
    crate_name: "regex_automata",
    crate_root: "src/lib.rs",
    cargo_pkg_version: "0.4.14",
    edition: "2021",
    stem: "libregex_automata",
    features: [
        "std",
        "alloc",
        "syntax",
        "perf",
        "perf-inline",
        "perf-literal",
        "perf-literal-substring",
        "perf-literal-multisubstring",
        "unicode",
        "unicode-age",
        "unicode-bool",
        "unicode-case",
        "unicode-gencat",
        "unicode-perl",
        "unicode-script",
        "unicode-segment",
        "meta",
        "nfa",
        "nfa-thompson",
        "nfa-pikevm",
        "nfa-backtrack",
        "dfa",
        "dfa-build",
        "dfa-search",
        "dfa-onepass",
        "hybrid",
    ],
    rustlibs: [
        "libmemchr",
        "liboperit_regex_syntax",
        "liboperit_aho_corasick",
    ],
    visibility: ["//visibility:public"],
}
