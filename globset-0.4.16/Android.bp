// globset 0.4.16 —— 树内无，vendored（0.4.17+ 转 edition 2024，树内 rustc 1.82/1.83 不支持，钉 0.4.16）
rust_library_rlib {
    name: "liboperit_globset",
    crate_name: "globset",
    stem: "libglobset",
    crate_root: "src/lib.rs",
    cargo_pkg_version: "0.4.16",
    edition: "2021",
    features: ["log"],
    rustlibs: [
        "libbstr",
        "liblog_rust",
        "liboperit_aho_corasick",
        "liboperit_regex_automata",
        "liboperit_regex_syntax",
    ],
    visibility: ["//visibility:public"],
}
