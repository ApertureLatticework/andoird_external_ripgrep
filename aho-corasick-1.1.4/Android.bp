// aho-corasick 1.1.4 —— operit ripgrep 源码线 vendored
// 树内 libaho_corasick 为 0.7 断代老线，故独立 liboperit_ 命名避让
rust_library {
    name: "liboperit_aho_corasick",
    crate_name: "aho_corasick",
    stem: "libaho_corasick",
    crate_root: "src/lib.rs",
    cargo_pkg_version: "1.1.4",
    edition: "2021",
    features: ["std", "perf-literal"],
    rustlibs: ["libmemchr"],
    visibility: ["//visibility:public"],
}
